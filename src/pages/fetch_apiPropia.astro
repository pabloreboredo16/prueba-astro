---
import Baselayout from "../layouts/Baselayout.astro";
import { GET } from "./api/hora.js";
export const prerender = false

const res = await GET()
const datos = await res.json()

---

<Baselayout>
    <h1>Fecha usando una API propia</h1>
    <p>La fecha y hora es: {datos.fechaHora}</p>
</Baselayout>