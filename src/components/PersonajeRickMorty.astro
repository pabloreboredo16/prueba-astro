---
const { nombre, imagen } = Astro.props;
---

<div class="card">
  <img src={imagen} alt={nombre} />
  <span>{nombre}</span>
</div>

<style>
    .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.5rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
        width: 120px; 
        text-align: center;
  }

    .card img {
        width: 80px;
        height: 80px;
        border-radius: 8px; 
  }

    .card span {
        margin-top: 0.5rem;
        font-size: 0.85rem;
        font-weight: 600;
  }
</style>