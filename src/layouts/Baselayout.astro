---
import Card from "../components/Card.astro";
import Menu from "../components/Menu.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Mi Web en Astro</title>
    </head>
    <body>
        <header>
            <Menu/>
        </header>

        <main class="container">
            <Card>
                <slot/>
            </Card>
        </main>
    </body>
</html>

<style is:global>

    /* TODO */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* BODY */
    body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #f8fafc; 
        color: #0f172a;           
        padding: 2rem 1rem;
        min-height: 100vh;
    }

    /* HEADER */
    header {
        max-width: 600px;
        margin: 0 auto 1.5rem auto;
        display: flex;
        justify-content: center;
    }

    /* CONTAINER */
    .container {
        max-width: 600px;
        margin: 0 auto;
    }

    /* TABLAS */
    .tabla-base {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.5rem;
    }
    .tabla-base th, 
    .tabla-base td {
        padding: 10px 15px;
        text-align: left;
        border-bottom: 1px solid #e2e8f0;
    }
    .tabla-base th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: bold;
    }
</style>